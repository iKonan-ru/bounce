# pnpm typegen: типы коллекций из запущенного PocketBase разработки (tools/pocketbase.sh).
# Скопировать в .env и вписать суперпользователя (tools/pocketbase.sh superuser upsert ...).
PB_TYPEGEN_URL=http://127.0.0.1:8090
PB_TYPEGEN_EMAIL=admin@example.com
PB_TYPEGEN_PASSWORD=

# tools/deploy.sh: сервер с Docker и Caddy и домен приложения
DEPLOY_HOST=root@203.0.113.10
DEPLOY_DOMAIN=bounce.example.com
# папка сайтов, которую подключает Caddyfile (import /etc/caddy/sites/*.caddy), и команда
# перезагрузки Caddy после смены сайта
DEPLOY_CADDY_SITES=/etc/caddy/sites
DEPLOY_CADDY_RELOAD="docker exec caddy caddy reload --config /etc/caddy/Caddyfile"
# сеть Docker, в которой Caddy видит контейнер приложения как bounce:8090
DEPLOY_NETWORK=caddy
# ключ и known_hosts - пути от корня репозитория или абсолютные
# DEPLOY_SSH_KEY=../.secrets/server_ed25519
# DEPLOY_KNOWN_HOSTS=../.secrets/known_hosts

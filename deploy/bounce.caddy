# Сайт Bounce для Caddy: /etc/caddy/sites/bounce.caddy. __DOMAIN__ подставляет
# tools/deploy.sh из DEPLOY_DOMAIN.
__DOMAIN__ {
	encode zstd gzip
	# defer: заменить заголовки ответа PocketBase, а не добавить вторые рядом
	header {
		defer
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex"
	}
	# сайт закрыт от поисковиков и сборщиков данных: robots.txt запрещает всё, в каждом ответе
	# noindex, а известные роботы (поиск, ИИ, SEO-сервисы, превью ссылок) получают 403
	@robot {
		not path /robots.txt
		header_regexp User-Agent (?i)(googlebot|google-extended|google-inspectiontool|adsbot|mediapartners|bingbot|bingpreview|msnbot|yandex\.com/bots|baiduspider|duckduckbot|slurp|applebot|petalbot|sogou|seznambot|mail\.ru_bot|gptbot|chatgpt-user|oai-searchbot|claudebot|claude-web|anthropic-ai|perplexitybot|ccbot|bytespider|amazonbot|meta-externalagent|facebookexternalhit|facebookbot|twitterbot|linkedinbot|telegrambot|whatsapp|discordbot|slackbot|vkshare|ahrefsbot|semrushbot|mj12bot|dotbot|dataforseobot|blexbot|serpstatbot|ia_archiver|archive\.org_bot|cohere-ai|diffbot|imagesiftbot|omgili|youbot|timpibot)
	}
	handle @robot {
		respond 403
	}
	# админка PocketBase и вход суперпользователя снаружи закрыты: суперпользователь обходит все
	# правила и 2FA приложения; при необходимости админка открывается через SSH-туннель (README).
	# Коллекция адресуется и по имени, и по id (pbc_3142635823); вход через прокси отклоняет и
	# сам PocketBase (pb_hooks/superusers.pb.js)
	@pbadmin path /_ /_/* /api/collections/_superusers/* /api/collections/pbc_3142635823/*
	handle @pbadmin {
		respond 404
	}
	handle /robots.txt {
		respond "User-agent: *
Disallow: /
" 200
	}
	handle {
		# пока контейнер перезапускается при выкладке, запрос ждёт его, а не получает 502
		reverse_proxy bounce:8090 {
			lb_try_duration 30s
			lb_try_interval 250ms
		}
	}
}
